{
  "manifest_version": 3,
  "name": "Geo Guess",
  "version": "1.2.1",
  "key": "",
  "permissions": ["nativeMessaging", "windows"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "description": "Hides the place name, search box, and minimap so a round does not give away the answer.",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*"
      ],
      "js": ["hide.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["countries.json", "towns.json", "states.json", "map/*"],
      "matches": ["https://www.google.com/*", "https://maps.google.com/*"]
    }
  ]
}
