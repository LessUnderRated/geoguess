#!/bin/bash
# Open a Street View URL, then Hyprland-fullscreen that window (Super+F).

url=$1
if [[ -z $url ]]; then
  echo "open-streetview needs a url" >&2
  exit 2
fi
base=${url%%#*}
case $base in
  https://www.google.com/maps/*|https://maps.google.com/*) ;;
  *) echo "refusing non-maps url" >&2; exit 2 ;;
esac
if [[ $url == *$'\n'* || $url == *$'\r'* || $url == *"'"* || $url == *'"'* || $url == *'`'* || $url == *'$'* ]]; then
  echo "refusing unsafe url" >&2
  exit 2
fi

python3 - "$url" << 'PY'
import json, os, re, select, subprocess, sys, time

ADDRESS_RE = re.compile(r"^0x[0-9a-fA-F]+$")
MAPS_RE = re.compile(
    r"^https://(www\.google\.com/maps|maps\.google\.com)/[A-Za-z0-9._~:/?#@!+=&%,-]*$"
)
MAX_HYPR_BYTES = 1024 * 1024

url = sys.argv[1]
base = url.split("#", 1)[0]
if len(base) < 24 or len(base) > 4096 or not MAPS_RE.fullmatch(base):
    sys.exit(2)


def capped_stdout(argv, timeout, limit):
    proc = subprocess.Popen(
        argv,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        bufsize=0,
    )
    chunks = []
    total = 0
    deadline = time.monotonic() + timeout
    fd = proc.stdout.fileno()
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                proc.kill()
                proc.wait()
                raise subprocess.TimeoutExpired(argv, timeout)
            ready, _, _ = select.select([fd], [], [], remaining)
            if not ready:
                proc.kill()
                proc.wait()
                raise subprocess.TimeoutExpired(argv, timeout)
            buf = os.read(fd, min(8192, limit + 1 - total))
            if not buf:
                break
            total += len(buf)
            if total > limit:
                proc.kill()
                proc.wait()
                return None
            chunks.append(buf)
        proc.wait(timeout=max(0.1, deadline - time.monotonic()))
        return b"".join(chunks)
    finally:
        if proc.stdout:
            try:
                proc.stdout.close()
            except OSError:
                pass
        if proc.poll() is None:
            proc.kill()
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                pass


def load_clients(raw):
    if not raw:
        return []
    try:
        data = json.loads(raw.decode("utf-8"))
    except ValueError:
        return []
    if not isinstance(data, list):
        return []
    return data


def clients():
    try:
        raw = capped_stdout(["hyprctl", "clients", "-j"], timeout=5, limit=MAX_HYPR_BYTES)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return load_clients(raw)


def fullscreen(address):
    if not ADDRESS_RE.fullmatch(address or ""):
        return False
    target = "address:" + address
    cmd = (
        'hl.dsp.window.fullscreen({ window = "%s", mode = "fullscreen", action = "set" })'
        % target
    )
    result = subprocess.run(["hyprctl", "dispatch", cmd], text=True, capture_output=True)
    output = (result.stdout + result.stderr).lower()
    if result.returncode == 0 and "no target" not in output and "error" not in output:
        return True
    subprocess.run(
        ["hyprctl", "dispatch", 'hl.dsp.focus({ window = "%s" })' % target],
        check=False,
    )
    try:
        active_raw = capped_stdout(["hyprctl", "activewindow", "-j"], timeout=5, limit=MAX_HYPR_BYTES)
        active = json.loads(active_raw.decode("utf-8") if active_raw else "{}")
    except (OSError, subprocess.TimeoutExpired, ValueError, UnicodeDecodeError):
        return False
    if not isinstance(active, dict) or active.get("address") != address:
        return False
    subprocess.run(
        ["hyprctl", "dispatch", 'hl.dsp.window.fullscreen({ mode = "fullscreen" })'],
        check=False,
    )
    return True


before = {
    client["address"]
    for client in clients()
    if ADDRESS_RE.fullmatch(str(client.get("address") or ""))
}

try:
    subprocess.Popen(["omarchy-launch-webapp", url], start_new_session=True)
except OSError:
    sys.exit(1)

for _ in range(40):
    time.sleep(0.15)
    fresh = [
        client for client in clients()
        if ADDRESS_RE.fullmatch(str(client.get("address") or ""))
        and client.get("address") not in before
        and "chrom" in str(client.get("class", "")).lower()
    ]
    if not fresh:
        continue
    if fullscreen(fresh[-1]["address"]):
        sys.exit(0)

sys.exit(1)
PY
