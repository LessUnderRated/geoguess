#!/usr/bin/env python3
"""Keyless Street View URL helper (stdlib only, no API key).

Usage:
  streetview-lookup resolve <lat> <lon>
  streetview-lookup marker-url <lat> <lon> [name]
  streetview-lookup map-url <lat> <lon> [zoom]

`resolve` finds the nearest panorama with the same SingleImageSearch call
streetlevel uses, then builds streetlevel's permalink (a real pano id).
The Maps `viewpoint=` URL is not used: Google only snaps that within a few
dozen meters, so a globe click reports that no imagery exists.
"""
import json
import math
import random
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

# Socket timeout does not bound how large a body can be. Cap reads so a
# hostile or oversized Maps response cannot exhaust the helper's memory.
MAX_HTTP_BYTES = 2 * 1024 * 1024
_HTTP_CHUNK = 64 * 1024


class ResponseTooLarge(OSError):
    """HTTP body exceeded MAX_HTTP_BYTES."""


def read_http_text(request, timeout=12, limit=MAX_HTTP_BYTES):
    """Read an HTTP response with a hard size cap, then decode as UTF-8."""
    with urllib.request.urlopen(request, timeout=timeout) as response:
        declared = response.headers.get("Content-Length")
        if declared:
            try:
                if int(declared) > limit:
                    raise ResponseTooLarge("HTTP Content-Length exceeds %s bytes" % limit)
            except ValueError:
                pass
        chunks = []
        total = 0
        while True:
            remaining = limit - total
            chunk = response.read(_HTTP_CHUNK if remaining == 0 else min(_HTTP_CHUNK, remaining + 1))
            if not chunk:
                break
            total += len(chunk)
            if total > limit:
                raise ResponseTooLarge("HTTP body exceeds %s bytes" % limit)
            chunks.append(chunk)
        return b"".join(chunks).decode("utf-8", "replace")


def die(msg, code=2):
    print(json.dumps({"ok": False, "error": msg}))
    sys.exit(code)


def parse_latlon(lat_s, lon_s):
    try:
        lat = float(lat_s)
        lon = float(lon_s)
    except (TypeError, ValueError):
        die("invalid coordinates")
    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
        die("coordinates out of range")
    return lat, lon


# Globe clicks land far from a road. Google's viewpoint URL does not search
# that far and shows "no imagery". This radius is the nearest-pano lookup.
SEARCH_RADIUS_METERS = 100_000


def is_third_party_panoid(panoid):
    # Same rule as streetlevel.streetview.util.is_third_party_panoid.
    return panoid.startswith("CIHM0og") or len(panoid) > 22


PANO_ID_RE = re.compile(r"^[A-Za-z0-9_-]{4,200}$")


def safe_panoid(panoid):
    """Reject panorama ids that could break a quoted shell command or URL."""
    if not isinstance(panoid, str) or not PANO_ID_RE.fullmatch(panoid):
        return None
    return panoid


def permalink(pano_id, lat, lon, heading=0.0, pitch=90.0, fov=75.0):
    # streetlevel build_permalink. The official viewpoint URL does not open
    # third-party panorama ids, and it fails when the click is off a road.
    panoid = safe_panoid(pano_id)
    if not panoid:
        return ""
    kind = 10 if is_third_party_panoid(panoid) else 2
    return (
        f"https://www.google.com/maps/@{lat},{lon},3a,{fov}y,{heading}h,{pitch}t"
        f"/data=!3m4!1e1!3m2!1s{panoid}!2e{kind}"
    )


def find_place(name, lat, lon):
    # Keyless maps search. The hex id is what puts a panorama on the place's
    # photo strip; without it Maps opens one image and shows no page arrows.
    query = urllib.parse.urlencode({
        "tbm": "map",
        "hl": "en",
        "q": name,
        "pb": f"!4m12!1m3!1d4000!2d{lon}!3d{lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!7i20!8m2!1e1!2e1",
    })
    request = urllib.request.Request(
        "https://www.google.com/search?" + query,
        headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                               "(KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"},
    )
    try:
        text = read_http_text(request)
    except (urllib.error.URLError, TimeoutError, OSError):
        return None
    found = re.search(
        r'\[null,null,(-?\d+\.?\d*),(-?\d+\.?\d*)\],"(0x[0-9a-f]+:0x[0-9a-f]+)","([^"]+)"',
        text,
    )
    if not found:
        found = re.search(
            r'"(0x[0-9a-f]+:0x[0-9a-f]+)",\[null,null,(-?\d+\.?\d*),(-?\d+\.?\d*)\],"([^"]+)"',
            text,
        )
        if not found:
            return None
        feature, lat_s, lon_s, title = found.group(1), found.group(2), found.group(3), found.group(4)
    else:
        lat_s, lon_s, feature, title = found.group(1), found.group(2), found.group(3), found.group(4)
    title = title.split(",")[0].strip()
    return {
        "featureId": feature,
        "lat": float(lat_s),
        "lon": float(lon_s),
        "name": title or name,
    }


def place_page(name, pano_id, lat, lon, feature_id="", place_lat=None, place_lon=None,
               heading=0.0, pitch=90.0, fov=75.0):
    # Same shape as a place photo that has the bottom arrows: the panorama,
    # then the place feature id. A visitor photosphere link has neither.
    from urllib.parse import quote
    panoid = safe_panoid(pano_id)
    if not panoid:
        return ""
    slug = quote((name or "Landmark").replace("/", " "), safe="")
    kind = 10 if is_third_party_panoid(panoid) else 0
    thumb = quote(
        "https://streetviewpixels-pa.googleapis.com/v1/thumbnail"
        f"?cb_client=maps_sv.tactile&w=900&h=600&pitch=0&panoid={panoid}&yaw={heading}",
        safe="",
    )
    url = (
        f"https://www.google.com/maps/place/{slug}/@{lat},{lon},3a,{fov}y,{heading}h,{pitch}t"
        f"/data=!3m7!1e1!3m5!1s{panoid}!2e{kind}!6s{thumb}!7i13312!8i6656"
    )
    if feature_id:
        if not re.fullmatch(r"0x[0-9a-f]+:0x[0-9a-f]+", feature_id):
            feature_id = ""
        else:
            plat = place_lat if place_lat is not None else lat
            plon = place_lon if place_lon is not None else lon
            url += f"!4m9!3m8!1s{feature_id}!8m2!3d{plat}!4d{plon}!10e5!14m1!1BCgIgARICCAI"
    return url


def place_photo(feature_id):
    # First Street View photo on the place. This is the image the bottom arrows page through.
    if not isinstance(feature_id, str) or not re.fullmatch(r"0x[0-9a-f]+:0x[0-9a-f]+", feature_id):
        return None
    url = (
        "https://www.google.com/maps/rpc/photo/listentityphotos?authuser=0&hl=en&gl=us&pb="
        f"!1e2!3m5!1s{feature_id}!9e0!11m2!1m1!1e1!15m2!1m1!4s"
    )
    request = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                      "(KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
    })
    try:
        text = read_http_text(request)
    except (urllib.error.URLError, TimeoutError, OSError):
        return None
    ident = re.search(r'\["([A-Za-z0-9_-]{22})",0,1,"', text)
    camera = re.search(
        r'\[\[3,(-?\d+\.\d+),(-?\d+\.\d+)\],\[(-?\d+\.?\d*),(-?\d+\.?\d*)\]',
        text,
    )
    if not ident or not camera:
        return None
    panoid = safe_panoid(ident.group(1))
    if not panoid:
        return None
    return {
        "pano": panoid,
        "lon": float(camera.group(1)),
        "lat": float(camera.group(2)),
        "heading": float(camera.group(3)),
        "pitch": float(camera.group(4)),
    }


def landmark_url(name, lat, lon):
    place = find_place(name, lat, lon) if name else None
    if not place:
        return ""
    photo = place_photo(place["featureId"])
    if not photo:
        return ""
    return place_page(
        place["name"], photo["pano"], photo["lat"], photo["lon"],
        feature_id=place["featureId"], place_lat=place["lat"], place_lon=place["lon"],
        heading=photo["heading"], pitch=photo["pitch"],
    )


def haversine_meters(lat1, lon1, lat2, lon2):
    radius = 6371000.0
    phi1, phi2 = math.radians(lat1), math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlambda = math.radians(lon2 - lon1)
    a = math.sin(dphi / 2) ** 2 + math.cos(phi1) * math.cos(phi2) * math.sin(dlambda / 2) ** 2
    return 2 * radius * math.asin(min(1.0, math.sqrt(a)))


