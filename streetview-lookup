    "everywhere": STREET_BOXES,
    "usa": USA_BOXES,
    "eu": EU_BOXES,
    "asia": ASIA_BOXES,
}


def tile_xy(lat, lon, zoom=17):
    size = 2 ** zoom
    x = int((lon + 180.0) / 360.0 * size)
    lat_r = math.radians(max(-85.0, min(85.0, lat)))
    y = int((1.0 - math.log(math.tan(lat_r) + 1.0 / math.cos(lat_r)) / math.pi) / 2.0 * size)
    return max(0, x), max(0, y)


def official_panos(tile_x, tile_y):
    """Official road panoramas in one coverage tile. These have street links."""
    url = (
        "https://www.google.com/maps/photometa/ac/v1?pb="
        f"!1m1!1smaps_sv.tactile!6m3!1i{tile_x}!2i{tile_y}!3i17!8b1"
    )
    request = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                      "(KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
    })
    try:
        text = read_http_text(request)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        die(f"street view lookup failed: {exc}")
    found = re.findall(
        r'\[2,"([^"]+)"\],null,\[\[null,null,(-?\d+\.\d+),(-?\d+\.\d+)\]',
        text,
    )
    panos = []
    for pano_id, lat, lon in found:
        panoid = safe_panoid(pano_id)
        if not panoid or is_third_party_panoid(panoid):
            continue
        panos.append({"pano": panoid, "lat": float(lat), "lon": float(lon)})
    return panos


def landmark_points():
    path = Path(__file__).with_name("treasures.json")
    rows = json.loads(path.read_text())
    return [(float(row["latitude"]), float(row["longitude"])) for row in rows]


def random_street_panorama(region="everywhere"):
    for _ in range(8):
        if region == "landmarks":
            lat, lon = random.choice(landmark_points())
            lat += random.uniform(-0.003, 0.003)
            lon += random.uniform(-0.003, 0.003)
        else:
            south, west, north, east = random.choice(REGION_BOXES.get(region, STREET_BOXES))
            lat = random.uniform(south, north)
            lon = random.uniform(west, east)
        tile_x, tile_y = tile_xy(lat, lon)
        panos = official_panos(tile_x, tile_y)
        if panos:
            return random.choice(panos)
    return None


def nearest_panorama(lat, lon, radius=SEARCH_RADIUS_METERS):
    """Keyless nearest-pano search used by the Maps JS Street View service."""
    pb = (
        "!1m5!1sapiv3!5sUS!11m2!1m1!1b0!2m4!1m2!"
        f"3d{lat:.7f}!4d{lon:.7f}!2d{int(radius)}!3m18!2m2!1sen!2sUS!9m1!1e2!"
        "11m12!1m3!1e2!2b1!3e2!1m3!1e3!2b1!3e2!1m3!1e10!2b1!3e2!"
        "4m6!1e1!1e2!1e3!1e4!1e8!1e6"
    )
    url = (
        "https://maps.googleapis.com/maps/api/js/GeoPhotoService.SingleImageSearch"
        "?pb=" + pb + "&callback=_xdc_._cb"
    )
    request = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                      "(KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
    })
    try:
        text = read_http_text(request)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        die(f"street view lookup failed: {exc}")

    if "Search returned no images" in text:
        return None

    found = re.search(r'\[\[1\],\[(?:2|10),"([^"]+)"\]', text)
    if not found:
        return None
    panoid = safe_panoid(found.group(1))
    if not panoid:
        return None
    snapped = re.search(r'\[null,null,(-?\d+\.\d+),(-?\d+\.\d+)\]', text)
    name = re.search(r'\[\["([^"]+)"\]', text)
    snapped_lat = float(snapped.group(1)) if snapped else lat
    snapped_lon = float(snapped.group(2)) if snapped else lon
    return {
        "pano": panoid,
        "lat": snapped_lat,
        "lon": snapped_lon,
        "name": name.group(1) if name else "",
        "distanceMeters": round(haversine_meters(lat, lon, snapped_lat, snapped_lon)),
    }


def map_url(lat, lon, zoom=14):
    return f"https://www.google.com/maps/@?api=1&map_action=map&center={lat:.6f},{lon:.6f}&zoom={zoom}"


def cmd_resolve(args):
    if len(args) < 2:
        die("resolve needs <lat> <lon>")
    lat, lon = parse_latlon(args[0], args[1])
    pano = nearest_panorama(lat, lon)
    if not pano:
        die(f"No Street View within {SEARCH_RADIUS_METERS // 1000} km of this spot")
    url = permalink(pano["pano"], pano["lat"], pano["lon"])
    if not url:
        die("Street View returned an unsafe panorama id")
    asked = " ".join(args[2:]).strip()
    label = asked or pano["name"] or f"{pano['lat']:.4f}, {pano['lon']:.4f}"
    gallery = landmark_url(asked, lat, lon) if asked else ""
    if gallery:
        url = gallery
    print(json.dumps({
        "ok": True,
        "lat": pano["lat"],
        "lon": pano["lon"],
        "requestedLat": lat,
        "requestedLon": lon,
        "pano": pano["pano"],
        "name": pano["name"],
        "distanceMeters": pano["distanceMeters"],
        "url": url,
        "placeUrl": gallery or url,
        "mapUrl": map_url(pano["lat"], pano["lon"]),
        "label": label,
    }))


def cmd_marker_url(args):
    if len(args) < 2:
        die("marker-url needs <lat> <lon> [name]")
    lat, lon = parse_latlon(args[0], args[1])
    name = args[2] if len(args) > 2 else ""
    pano = nearest_panorama(lat, lon)
    if not pano:
        die(f"No Street View within {SEARCH_RADIUS_METERS // 1000} km of this spot")
    url = permalink(pano["pano"], pano["lat"], pano["lon"])
    if not url:
        die("Street View returned an unsafe panorama id")
    print(json.dumps({
        "ok": True,
        "lat": pano["lat"],
        "lon": pano["lon"],
        "url": url,
        "mapUrl": map_url(pano["lat"], pano["lon"]),
        "name": name or pano["name"],
        "pano": pano["pano"],
        "distanceMeters": pano["distanceMeters"],
    }))


def cmd_street(args):
    region = args[0] if args else "everywhere"
    pano = random_street_panorama(region)
    if not pano:
        die("No walkable Street View found")
    url = permalink(pano["pano"], pano["lat"], pano["lon"])
    if not url:
        die("Street View returned an unsafe panorama id")
    print(json.dumps({
        "ok": True,
        "lat": pano["lat"],
        "lon": pano["lon"],
        "pano": pano["pano"],
        "name": "",
        "distanceMeters": 0,
        "url": url,
        "mapUrl": "",
        "label": "",
    }))


def cmd_map_url(args):
    if len(args) < 2:
        die("map-url needs <lat> <lon> [zoom]")
    lat, lon = parse_latlon(args[0], args[1])
    zoom = int(args[2]) if len(args) > 2 else 14
    print(map_url(lat, lon, zoom))


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 2
    cmd, rest = argv[1], argv[2:]
    if cmd == "resolve":
        cmd_resolve(rest)
    elif cmd == "street":
        cmd_street(rest)
    elif cmd == "marker-url":
        cmd_marker_url(rest)
    elif cmd == "map-url":
        cmd_map_url(rest)
    else:
        die(f"unknown command: {cmd}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
